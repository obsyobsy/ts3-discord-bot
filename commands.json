        "type": 1,
        "options": [
          { "name": "channel", "description": "Canale testuale", "type": 7, "required": true }
        ]
      }
    ]
  },
  {
    "name": "backup",
    "description": "Esporta la configurazione TS3-like",
    "type": 1,
    "dm_permission": false,
    "options": [
      {
        "name": "export",
