        "options": [
          { "name": "user", "description": "Utente Discord", "type": 6, "required": true },
          { "name": "group", "description": "Nome del gruppo", "type": 3, "required": true }
        ]
      },
      {
        "name": "remove-member",
        "description": "Rimuove un utente da un Server Group",
        "type": 1,
        "options": [
          { "name": "user", "description": "Utente Discord", "type": 6, "required": true },
          { "name": "group", "description": "Nome del gruppo", "type": 3, "required": true }
        ]
      }
    ]
  },
  {
