          { "name": "user", "description": "Utente Discord", "type": 6, "required": true },
          { "name": "key", "description": "Chiave permesso", "type": 3, "required": true },
          { "name": "value", "description": "Valore: true/false o numero", "type": 3, "required": true },
          { "name": "grant", "description": "Grant value", "type": 4, "required": false },
          { "name": "negated", "description": "Nega il permesso", "type": 5, "required": false },
          { "name": "skip", "description": "Riservato ai permessi canale futuri", "type": 5, "required": false }
        ]
      },
      {
        "name": "remove",
        "description": "Rimuove un permesso diretto da un utente",
