        ]
      },
      {
        "name": "create",
        "description": "Crea un Server Group vuoto",
        "type": 1,
        "options": [
          { "name": "name", "description": "Nome del gruppo", "type": 3, "required": true },
          { "name": "sort_order", "description": "Ordine logico del gruppo", "type": 4, "required": false }
        ]
      },
      {
        "name": "delete",
