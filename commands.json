        "options": [
          { "name": "name", "description": "Nome del gruppo", "type": 3, "required": true },
          { "name": "role", "description": "Ruolo Discord da sincronizzare", "type": 8, "required": true }
        ]
      },
      {
        "name": "set-perm",
        "description": "Imposta un permesso su un Server Group",
        "type": 1,
        "options": [
          { "name": "group", "description": "Nome del gruppo", "type": 3, "required": true },
          { "name": "key", "description": "Chiave permesso TS3-like", "type": 3, "required": true },
