    "type": 1,
    "dm_permission": false,
    "default_member_permissions": "8",
    "options": [
      {
        "name": "seed",
        "description": "Crea gruppi e permessi base, poi assegna Root a chi esegue",
        "type": 1
      }
    ]
  },
  {
    "name": "servergroup",
