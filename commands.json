      },
      {
        "name": "list",
        "description": "Mostra i permessi diretti di un utente",
        "type": 1,
        "options": [
          { "name": "user", "description": "Utente Discord", "type": 6, "required": true }
        ]
      }
    ]
  },
  {
    "name": "perm",
